# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so your secrets never reach GitHub.

PORT=5000

# From MongoDB Atlas: Connect -> Drivers. Put "cleardocs" after the last slash.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cleardocs

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Websites allowed to call the API (comma separated). 8081 is the Expo app running in a browser.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8081

# Used by "npm run seed" to create your admin account
ADMIN_EMAIL=admin@cleardocs.dev
ADMIN_PASSWORD=change_me_123
