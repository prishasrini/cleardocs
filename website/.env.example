# Copy this file to .env.local and fill in your values.

# Where the Express backend is running
NEXT_PUBLIC_API_URL=http://localhost:5000

# The website's own address (used in the sitemap and for SEO). Change it after deploying to Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your WordPress site's REST API (see WORDPRESS_SETUP.md). Leave it empty to use the sample posts.
#   Self-hosted / InstaWP / LocalWP:  https://yoursite.com/wp-json/wp/v2
#   WordPress.com free site:          https://public-api.wordpress.com/wp/v2/sites/yoursite.wordpress.com
WORDPRESS_API_URL=
